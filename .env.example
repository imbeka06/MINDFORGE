# MindForge AI - Environment Configuration
# Copy this file to .env and fill in your actual values

# OpenAI API Key
# Get your API key from: https://platform.openai.com/api-keys
# Sign up at: https://openai.com (requires payment method)
OPENAI_API_KEY=sk-your-api-key-here

# Optional: Model Selection (default is gpt-3.5-turbo)
# Available options: gpt-3.5-turbo, gpt-4-turbo
# OPENAI_MODEL=gpt-3.5-turbo
